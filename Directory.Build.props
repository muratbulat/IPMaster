<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Version>0.9.0</Version>
    <Authors>Murat Bulat</Authors>
    <Company>Murat Bulat</Company>
    <Copyright>Copyright © 2026 Murat Bulat</Copyright>
    <Product>IPMaster</Product>
    <!-- GPL-3.0-only (LICENSE, D-115); the source commit is appended to the informational version (+<sha>) -->
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/muratbulat/ipmaster</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
